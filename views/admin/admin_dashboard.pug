doctype html 
head
    title Admin Dashboard
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0")
    link(rel="stylesheet", href="/css/admin_dashboard.css")
body
    .header
        span#menu-icon.material-symbols-outlined menu
        ul#menu-dropdown.menu-list
            li: a#reset-password(href="/reset_password") Reset Password
            li: a#log-out(href="/admin_login") Log Out
        .search-bar
            span.material-symbols-outlined.search search
            input(type="text", id="search", name="search", placeholder="Search")
        .last-login
            span#last-login
    .actions
        button#btn-create-session Create Session
    .container
        table
            thead
                tr 
                    th QR Code
                    th Questions 
                    th Option A 
                    th Option B 
                    th Option C 
                    th Option D
                    th Answer 
                    th Levels
                    th Actions
            tbody#questions-data
    script(src="/js/admin_dashboard.js")