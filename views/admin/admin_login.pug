doctype html 
head
    title Admin Login
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0")
    link(rel="stylesheet", href="/css/admin_login.css")
body
    h1.title 
        span.yellow Py
        span.blue Cards
    .container
        h2 Login
        form#login-form(method="post")
            // Username Input
            .form-group 
                label(for="username") Username
                .input-wrapper
                    span.material-symbols-outlined account_circle
                    input(type="text", id="username", name="username", placeholder="Enter your username", required)
                
            // Password Input
            .form-group
                label(for="password") Password 
                .input-wrapper
                    span.material-symbols-outlined lock
                    input(type="password", id="password", name="password", placeholder="Enter your password", required)

            #error-message 
                
            // Actions
            .actions
                button.btn-register(type="button" onclick="window.location.href='/admin_registration'") Register
                button.btn-login(type="submit") Log In
    script(src="/js/admin_login.js")