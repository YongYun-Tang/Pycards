doctype html 
html 
    head 
        title Answering Room 
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0")
        link(rel="stylesheet", href="/css/answering_room.css")
    body 
        audio#countdown-sound(loop)
            source(src="/audio/countdown_sound.mp3" type="audio/mpeg")
        audio#correct-sound
            source(src="/audio/correct_sound.mp3" type="audio/mpeg")
        audio#incorrect-sound
            source(src="/audio/incorrect_sound.mp3" type="audio/mpeg")  
        .container
            h2 Answering Room 
            span#level

            .answering-time 
                #time-bar
                span.material-symbols-outlined#clock nest_clock_farsight_analog
                span#time-text 

            #question

            .options 
                button.option-btn(type="button" data-answer="A")
                    span.option-label A
                    span.option-text#option-a
                button.option-btn(type="button" data-answer="B")
                    span.option-label B 
                    span.option-text#option-b
                button.option-btn(type="button" data-answer="C")
                    span.option-label C 
                    span.option-text#option-c
                button.option-btn(type="button" data-answer="D")
                    span.option-label D
                    span.option-text#option-d
    script(src="/js/answering_room.js")