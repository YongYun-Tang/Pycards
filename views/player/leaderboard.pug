doctype html 
head
    title Leaderboard
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0")
    link(rel="stylesheet", href="/css/leaderboard.css")
body
    audio#first-place-sound
        source(src="/audio/first_place_sound.mp3" type="audio/mpeg")
    .container
        h1 Leader Board
        ol#leaderboard
        button#btn-scan Scan

    #result-popup
        .result-popup-content
            .material-symbols-outlined trophy

            h2 Session Ended

            p.winner-label Congrats!

            h3#winner-username

            p.winner-score
                span#winner-score scores

            button#btn-return(type="button") Return to Player Entry
    script(src="/js/leaderboard.js") 